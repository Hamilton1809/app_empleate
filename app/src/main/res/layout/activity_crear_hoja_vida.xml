<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    tools:context=".CrearHojaVidaActivity">

    <!-- Encabezado fijo -->
    <LinearLayout
        android:id="@+id/headerHV"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Crear Hoja de Vida (Paso 1)"
            android:textColor="#1E3A8A"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnMenuHV"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="Menú"
            android:clickable="true"
            android:focusable="true"
            android:src="@android:drawable/ic_menu_sort_by_size"
            app:tint="#1E3A8A" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@+id/headerHV"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <!-- Ícono de Perfil circular sin cuadrícula de fondo -->
            <androidx.cardview.widget.CardView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="50dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#EFF6FF">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Fotografía"
                    android:scaleType="centerCrop"
                    android:scaleX="1.65"
                    android:scaleY="1.65"
                    android:src="@drawable/logo_empleate" />
            </androidx.cardview.widget.CardView>

            <Button
                android:id="@+id/btnSubirFoto"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CARGAR FOTOGRAFÍA"
                android:textColor="#2563EB"
                android:textStyle="bold"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Datos Personales"
                android:textColor="#1E3A8A"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <EditText
                    android:id="@+id/etHvNombre"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_input"
                    android:hint="Nombres *"
                    android:inputType="textPersonName"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="#1E293B"
                    android:textColorHint="#64748B"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etHvApellido"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_input"
                    android:hint="Apellidos *"
                    android:inputType="textPersonName"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="#1E293B"
                    android:textColorHint="#64748B"
                    android:textSize="14sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/etHvCelular"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_input"
                android:hint="Número de celular *"
                android:inputType="phone"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#1E293B"
                android:textColorHint="#64748B"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etHvCorreo"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_input"
                android:hint="Correo electrónico *"
                android:inputType="textEmailAddress"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#1E293B"
                android:textColorHint="#64748B"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <EditText
                    android:id="@+id/etHvCiudad"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_input"
                    android:hint="Ciudad *"
                    android:inputType="text"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="#1E293B"
                    android:textColorHint="#64748B"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etHvDepto"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_input"
                    android:hint="Departamento *"
                    android:inputType="text"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="#1E293B"
                    android:textColorHint="#64748B"
                    android:textSize="14sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/etHvProfesion"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_input"
                android:hint="Profesión u ocupación *"
                android:inputType="text"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#1E293B"
                android:textColorHint="#64748B"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etHvLinkedin"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="28dp"
                android:background="@drawable/bg_input"
                android:hint="Enlace LinkedIn o portafolio"
                android:inputType="textUri"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#1E293B"
                android:textColorHint="#64748B"
                android:textSize="14sp" />

            <!-- Botón de Continuar para avanzar al Paso 2 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnContinuarPaso2"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="32dp"
                android:text="CONTINUAR AL PASO 2"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="#1E3A8A"
                app:cornerRadius="12dp"
                app:elevation="4dp" />

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
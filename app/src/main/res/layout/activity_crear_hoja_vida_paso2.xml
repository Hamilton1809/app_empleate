<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    tools:context=".CrearHojaVidaPaso2Activity">

    <!-- Encabezado con indicador de paso -->
    <LinearLayout
        android:id="@+id/headerPaso2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Paso 2 de 3"
            android:textColor="#1E3A8A"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="Menú"
            android:src="@android:drawable/ic_menu_sort_by_size"
            app:tint="#1E3A8A" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@+id/headerPaso2"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Sección 2: Perfil Profesional -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. Perfil Profesional"
                android:textColor="#1E3A8A"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/etHvCargo"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_input"
                android:hint="¿A qué cargo deseas postularte? *"
                android:inputType="text"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#1E293B"
                android:textColorHint="#64748B"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etHvAnosExp"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_input"
                android:hint="¿Cuántos años de experiencia tienes? *"
                android:inputType="number"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#1E293B"
                android:textColorHint="#64748B"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etHvAreasExp"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_input"
                android:gravity="top|start"
                android:hint="¿En qué áreas tienes experiencia? *"
                android:inputType="textMultiLine"
                android:padding="14dp"
                android:textColor="#1E293B"
                android:textColorHint="#64748B"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etHvFortalezas"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_input"
                android:gravity="top|start"
                android:hint="Describe tus principales fortalezas *"
                android:inputType="textMultiLine"
                android:padding="14dp"
                android:textColor="#1E293B"
                android:textColorHint="#64748B"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etHvCaracteristica"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_input"
                android:gravity="top|start"
                android:hint="¿Qué te caracteriza como trabajador?"
                android:inputType="textMultiLine"
                android:padding="14dp"
                android:textColor="#1E293B"
                android:textColorHint="#64748B"
                android:textSize="14sp" />

            <!-- Sección 3: Experiencia Laboral -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3. Experiencia Laboral"
                android:textColor="#1E3A8A"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="¿Tienes experiencia laboral?"
                android:textColor="#334155"
                android:textSize="14sp"
                android:layout_marginBottom="12dp" />

            <!-- Opciones de experiencia -->
            <RadioGroup
                android:id="@+id/rgExperiencia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <RadioButton
                    android:id="@+id/rbSiExperiencia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sí, tengo experiencia laboral."
                    android:textColor="#1E293B" />

                <RadioButton
                    android:id="@+id/rbNoExperiencia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No, busco mi primer empleo."
                    android:textColor="#1E293B" />
            </RadioGroup>

            <!-- Botón Agregar Experiencia -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAgregarExperiencia"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="32dp"
                android:text="+ AGREGAR EXPERIENCIA LABORAL"
                android:textColor="#1E3A8A"
                android:textStyle="bold"
                app:strokeColor="#1E3A8A"
                app:cornerRadius="8dp" />

            <!-- Sección 4: Formación Académica -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="4. Formación Académica"
                android:textColor="#1E3A8A"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- Ejemplo de un campo de estudio -->
            <EditText
                android:id="@+id/etInstitucion"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_input"
                android:hint="Nombre de la institución *"
                android:inputType="text"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#1E293B"
                android:textColorHint="#64748B"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etTitulo"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_input"
                android:hint="Título obtenido *"
                android:inputType="text"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#1E293B"
                android:textColorHint="#64748B"
                android:textSize="14sp" />

            <!-- Botón Agregar Estudio -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAgregarEstudio"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="32dp"
                android:text="+ AGREGAR ESTUDIO"
                android:textColor="#1E3A8A"
                android:textStyle="bold"
                app:strokeColor="#1E3A8A"
                app:cornerRadius="8dp" />

            <!-- Botón Continuar (al Paso 3) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnContinuarPaso3"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="24dp"
                android:text="CONTINUAR"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="#1E3A8A"
                app:cornerRadius="12dp" />

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
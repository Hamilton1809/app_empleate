<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    tools:context=".RegistrarHojaVidaActivity">

    <!-- Encabezado con Logo circular, título EMPLÉATE y Menú -->
    <LinearLayout
        android:id="@+id/headerRegistroHV"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.cardview.widget.CardView
            android:layout_width="54dp"
            android:layout_height="54dp"
            app:cardCornerRadius="27dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="#FFFFFF">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/logo_empleate"
                android:contentDescription="Logo EMPLEATE" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="EMPLÉATE"
            android:textColor="#0F172A"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:letterSpacing="0.05" />

        <ImageView
            android:id="@+id/btnMenuRegistroHV"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@android:drawable/ic_menu_sort_by_size"
            app:tint="#0F172A"
            android:contentDescription="Menú" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/headerRegistroHV"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="28dp">

            <!-- Textos informativos superiores -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="REGISTRA TU HOJA DE VIDA AQUÍ"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAlignment="center"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Contamos con más de 23.000 colaboradores a nivel nacional."
                android:textColor="#1E3A8A"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAlignment="center"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Recuerda que registrar y mantener actualizada tu hoja de vida es la manera más efectiva para trabajar con nosotros."
                android:textColor="#1E3A8A"
                android:textSize="12sp"
                android:textAlignment="center"
                android:layout_marginBottom="12dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#94A3B8"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ESTAMOS BUSCANDO A ALGUIEN COMO TÚ..."
                android:textColor="#1E3A8A"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ingresa tus datos de registro aquí"
                android:textColor="#0F172A"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textAlignment="center"
                android:layout_marginBottom="14dp" />

            <!-- 1. NOMBRES -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#2563EB"
                app:strokeColor="#1E3A8A"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp">

                    <EditText
                        android:id="@+id/etNombresHV"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="NOMBRES:"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#E6F0FF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:inputType="textPersonName" />

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@android:drawable/ic_menu_myplaces"
                        app:tint="#FFFFFF"
                        android:contentDescription="Nombres" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. APELLIDOS -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#2563EB"
                app:strokeColor="#1E3A8A"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp">

                    <EditText
                        android:id="@+id/etApellidosHV"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="APELLIDOS:"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#E6F0FF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:inputType="textPersonName" />

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@android:drawable/ic_menu_myplaces"
                        app:tint="#FFFFFF"
                        android:contentDescription="Apellidos" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. TIPO DE DOCUMENTO -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#2563EB"
                app:strokeColor="#1E3A8A"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp">

                    <EditText
                        android:id="@+id/etTipoDocumentoHV"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="TIPO DE DOCUMENTO:"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#E6F0FF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:focusable="false"
                        android:clickable="true" />

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@android:drawable/ic_menu_edit"
                        app:tint="#FFFFFF"
                        android:contentDescription="Tipo de documento" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 4. TELÉFONO -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#2563EB"
                app:strokeColor="#1E3A8A"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp">

                    <EditText
                        android:id="@+id/etTelefonoHV"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="TELÉFONO:"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#E6F0FF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:inputType="phone" />

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@android:drawable/ic_menu_call"
                        app:tint="#FFFFFF"
                        android:contentDescription="Teléfono" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 5. CORREO ELECTRÓNICO -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#2563EB"
                app:strokeColor="#1E3A8A"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp">

                    <EditText
                        android:id="@+id/etCorreoHV"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="CORREO ELECTRÓNICO:"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#E6F0FF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:inputType="textEmailAddress" />

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@android:drawable/ic_dialog_email"
                        app:tint="#FFFFFF"
                        android:contentDescription="Correo" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 6. PERFIL PROFESIONAL -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#2563EB"
                app:strokeColor="#1E3A8A"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp">

                    <EditText
                        android:id="@+id/etPerfilProfesionalHV"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="PERFIL PROFESIONAL:"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#E6F0FF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:inputType="textCapSentences" />

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@android:drawable/ic_menu_info_details"
                        app:tint="#FFFFFF"
                        android:contentDescription="Perfil profesional" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 7. ESTUDIOS FORMALES -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#2563EB"
                app:strokeColor="#1E3A8A"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp">

                    <EditText
                        android:id="@+id/etEstudiosFormalesHV"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="ESTUDIOS FORMALES:"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#E6F0FF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:inputType="textCapSentences" />

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@android:drawable/ic_menu_agenda"
                        app:tint="#FFFFFF"
                        android:contentDescription="Estudios formales" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 8. EXPERIENCIA LABORAL -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#2563EB"
                app:strokeColor="#1E3A8A"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp">

                    <EditText
                        android:id="@+id/etExperienciaLaboralHV"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="EXPERIENCIA LABORAL:"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#E6F0FF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:inputType="textCapSentences" />

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@android:drawable/ic_menu_manage"
                        app:tint="#FFFFFF"
                        android:contentDescription="Experiencia laboral" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 9. REFERENCIAS LABORALES -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#2563EB"
                app:strokeColor="#1E3A8A"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp">

                    <EditText
                        android:id="@+id/etRefLaboralesHV"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="REFERENCIAS LABORALES:"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#E6F0FF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:inputType="textCapSentences" />

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@android:drawable/ic_menu_manage"
                        app:tint="#FFFFFF"
                        android:contentDescription="Referencias laborales" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 10. REFERENCIAS FAMILIARES -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#2563EB"
                app:strokeColor="#1E3A8A"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp">

                    <EditText
                        android:id="@+id/etRefFamiliaresHV"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="REFERENCIAS FAMILIARES:"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#E6F0FF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:inputType="textCapSentences" />

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@android:drawable/ic_menu_myplaces"
                        app:tint="#FFFFFF"
                        android:contentDescription="Referencias familiares" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Botones inferiores redondeados: CANCELAR y GUARDAR CAMBIOS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelarRegistroHV"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="CANCELAR"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="#1E3A8A"
                    app:cornerRadius="25dp"
                    app:elevation="3dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGuardarCambiosHV"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1.2"
                    android:layout_marginStart="6dp"
                    android:text="GUARDAR CAMBIOS"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="#2196F3"
                    app:cornerRadius="25dp"
                    app:elevation="3dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
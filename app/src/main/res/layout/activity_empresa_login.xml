<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    tools:context=".EmpresaLoginActivity">

    <!-- Header Superior -->
    <LinearLayout
        android:id="@+id/headerEmpresaLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.cardview.widget.CardView
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Logo EMPLEATE"
                android:scaleType="centerCrop"
                android:scaleX="1.65"
                android:scaleY="1.65"
                android:src="@drawable/logo_empleate" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="EMPLEATE"
            android:textColor="#1E3A8A"
            android:textSize="18sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="Menú"
            android:src="@android:drawable/ic_menu_sort_by_size"
            app:tint="#1E3A8A" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@+id/headerEmpresaLogin"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavContainerLogin">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Iniciar sesión"
                android:textColor="#1E3A8A"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginBottom="32dp" />

            <!-- Input ID Empresa -->
            <EditText
                android:id="@+id/etIdEmpresa"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_input"
                android:drawableStart="@android:drawable/ic_dialog_email"
                android:drawablePadding="12dp"
                android:drawableTint="#1E3A8A"
                android:hint="ID de Empresa"
                android:inputType="text"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#1E293B"
                android:textColorHint="#64748B"
                android:textSize="14sp" />

            <!-- Input Contraseña -->
            <EditText
                android:id="@+id/etPasswordEmpresa"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_input"
                android:drawableStart="@android:drawable/ic_lock_lock"
                android:drawablePadding="12dp"
                android:drawableTint="#1E3A8A"
                android:hint="Contraseña"
                android:inputType="textPassword"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#1E293B"
                android:textColorHint="#64748B"
                android:textSize="14sp" />

            <!-- Botón Iniciar Sesión Empresa -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIniciarSesionEmpresa"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="20dp"
                android:text="INICIAR SESION EMPRESA"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="#1E3A8A"
                app:cornerRadius="12dp"
                app:elevation="4dp" />

            <!-- Continuar con -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="O continuar con"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <ImageView
                    android:id="@+id/btnGoogleEmpresa"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="Google"
                    android:src="@android:drawable/ic_dialog_email"
                    android:background="@drawable/bg_social_btn"
                    android:padding="10dp"
                    android:layout_marginEnd="16dp"
                    app:tint="#1E3A8A"/>

                <ImageView
                    android:id="@+id/btnAppleEmpresa"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="Apple"
                    android:src="@android:drawable/ic_menu_info_details"
                    android:background="@drawable/bg_social_btn"
                    android:padding="10dp"
                    android:layout_marginEnd="16dp"
                    app:tint="#1E3A8A"/>

                <ImageView
                    android:id="@+id/btnFacebookEmpresa"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="Facebook"
                    android:src="@android:drawable/ic_menu_share"
                    android:background="@drawable/bg_social_btn"
                    android:padding="10dp"
                    app:tint="#1E3A8A"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvOlvidastePassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¿Olvidaste la contraseña?"
                android:textColor="#2563EB"
                android:textSize="13sp"
                android:textStyle="bold"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tvRegistrarPerfilEmpresa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¿No tienes cuenta? Registra tu empresa aquí"
                android:textColor="#1E3A8A"
                android:textSize="13sp"
                android:textStyle="bold"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Nav Bar -->
    <androidx.cardview.widget.CardView
        android:id="@+id/bottomNavContainerLogin"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:cardElevation="10dp"
        app:cardBackgroundColor="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:gravity="center_vertical">

            <LinearLayout
                android:id="@+id/btnNavInicioLogin"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@android:drawable/ic_menu_today"
                    app:tint="#1E3A8A" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Inicio"
                    android:textColor="#1E3A8A"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnNavBuscarLogin"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@android:drawable/ic_menu_search"
                    app:tint="#64748B" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Buscar"
                    android:textColor="#64748B"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnNavAgendaLogin"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@android:drawable/ic_menu_agenda"
                    app:tint="#64748B" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Agenda"
                    android:textColor="#64748B"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnNavPerfilLogin"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@android:drawable/ic_menu_myplaces"
                    app:tint="#64748B" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Perfil"
                    android:textColor="#64748B"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
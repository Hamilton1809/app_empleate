<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <!-- Encabezado -->
    <LinearLayout
        android:id="@+id/headerImprimir"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/logo_empleate"
            android:contentDescription="Logo EMPLEATE" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btnMenuImprimir"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@android:drawable/ic_menu_sort_by_size"
            app:tint="#1E3A8A"
            android:contentDescription="Menú" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/headerImprimir"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Imprimir hoja de vida"
                android:textColor="#0F172A"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textAlignment="center"
                android:layout_marginBottom="8dp" />

            <View
                android:layout_width="180dp"
                android:layout_height="2dp"
                android:background="#94A3B8"
                android:layout_marginBottom="24dp" />

            <!-- COPIAR LINK -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="COPIAR LINK"
                        android:textColor="#0F172A"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCopiarLink"
                        android:layout_width="210dp"
                        android:layout_height="48dp"
                        android:text="COPIAR"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        app:backgroundTint="#2563EB"
                        app:cornerRadius="24dp"
                        app:elevation="2dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- DESCARGAR PDF -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DESCARGAR PDF"
                        android:textColor="#0F172A"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDescargarPDF"
                        android:layout_width="210dp"
                        android:layout_height="48dp"
                        android:text="DESCARGAR"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        app:backgroundTint="#2563EB"
                        app:cornerRadius="24dp"
                        app:elevation="2dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- DESCARGAR WORD -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DESCARGAR WORD"
                        android:textColor="#0F172A"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDescargarWord"
                        android:layout_width="210dp"
                        android:layout_height="48dp"
                        android:text="DESCARGAR"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        app:backgroundTint="#2563EB"
                        app:cornerRadius="24dp"
                        app:elevation="2dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- BOTÓN PRINCIPAL REDONDEADO: IMPRIMIR HOJA DE VIDA -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnImprimir"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="20dp"
                android:text="IMPRIMIR HOJA DE VIDA"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="#1E3A8A"
                app:cornerRadius="28dp"
                app:elevation="4dp"
                app:icon="@android:drawable/ic_menu_save"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconTint="#FFFFFF" />
            <!-- BOTÓN PARA IR A ENTRENAMIENTOS Y TIPS IA -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIrEntrenamientosIA"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="24dp"
                android:text="ENTRENAMIENTOS Y TIPS IA"
                android:textColor="#1E3A8A"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="#FFFFFF"
                app:strokeColor="#1E3A8A"
                app:strokeWidth="2dp"
                app:cornerRadius="28dp"
                app:elevation="3dp"
                app:icon="@android:drawable/ic_menu_manage"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconTint="#1E3A8A" />

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
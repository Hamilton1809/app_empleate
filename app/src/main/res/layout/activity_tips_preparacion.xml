<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    tools:context=".TipsPreparacionActivity">

    <!-- Encabezado con regreso y menú -->
    <LinearLayout
        android:id="@+id/headerTips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnRegresarTips"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#1E3A8A"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Regresar" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tips de Preparación IA"
                android:textColor="#1E3A8A"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvUserEmailTipsHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="usuario@gmail.com"
                android:textColor="#2563EB"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnMenuTips"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@android:drawable/ic_menu_sort_by_size"
            app:tint="#1E3A8A"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Menú" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@+id/headerTips"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="32dp">

            <!-- Banner Hero de la Pantalla de Tips -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#1E3A8A">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="GUÍA ESTRATÉGICA IA DE PREPARACIÓN"
                        android:textColor="#93C5FD"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/tvCargoTipsHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tips adaptados para: Desarrollador / Profesional"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCambiarCargoTips"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="Cambiar cargo objetivo"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:strokeColor="#93C5FD"
                        app:strokeWidth="1dp"
                        app:cornerRadius="19dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- TIP 1: Control de Tiempo -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTipTiempoDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#EFF6FF"
                app:strokeColor="#BFDBFE"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@android:drawable/btn_star_big_on"
                            app:tint="#D97706"
                            android:layout_marginEnd="10dp"
                            android:contentDescription="Estrella" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1. Control de Tiempo y Estrés"
                            android:textColor="#1E3A8A"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvTipTiempoDetalle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Cargando tip de tiempo adaptado..."
                        android:textColor="#334155"
                        android:textSize="14sp"
                        android:lineSpacingExtra="3dp"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnProbarReloj"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_gravity="end"
                        android:text="Ver recomendación completa →"
                        android:textColor="#2563EB"
                        android:textStyle="bold"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- TIP 2: Identificación de Puntos Débiles -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTipDebilesDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#EFF6FF"
                app:strokeColor="#BFDBFE"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@android:drawable/ic_menu_mylocation"
                            app:tint="#2563EB"
                            android:layout_marginEnd="10dp"
                            android:contentDescription="Ubicación" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2. Diagnóstico de Temas Débiles"
                            android:textColor="#1E3A8A"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Revisa constantemente tu gráfico de avance. Refuerza las preguntas donde tuviste dudas antes de acudir a la entrevista de selección."
                        android:textColor="#334155"
                        android:textSize="14sp"
                        android:lineSpacingExtra="3dp"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVerDiagnostico"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_gravity="end"
                        android:text="Ver mi gráfico de avance →"
                        android:textColor="#2563EB"
                        android:textStyle="bold"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- TIP 3: Rutina Diaria de 10 Minutos -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTipDiarioDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#EFF6FF"
                app:strokeColor="#BFDBFE"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@android:drawable/ic_menu_recent_history"
                            app:tint="#1D4ED8"
                            android:layout_marginEnd="10dp"
                            android:contentDescription="Reloj" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3. Rutina Diaria de 10 Minutos"
                            android:textColor="#1E3A8A"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="La práctica constante de 10 minutos al día mejora la fluidez en tus respuestas, elimina los bloqueos mentales y aumenta tu confianza en un 80%."
                        android:textColor="#334155"
                        android:textSize="14sp"
                        android:lineSpacingExtra="3dp"
                        android:layout_marginBottom="14dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnIniciarRutinaDiaria"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="INICIAR RUTINA DE 10 MINUTOS"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:backgroundTint="#1E3A8A"
                        app:cornerRadius="12dp"
                        app:elevation="3dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- TIP 4: Preguntas Trampa en Entrevistas -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#EFF6FF"
                app:strokeColor="#BFDBFE"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@android:drawable/ic_menu_help"
                            app:tint="#0284C7"
                            android:layout_marginEnd="10dp"
                            android:contentDescription="Ayuda" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4. Preguntas Trampa Frecuentes"
                            android:textColor="#1E3A8A"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Cuando te pregunten '¿Cuál es tu mayor defecto?', responde con un área de mejora real acompañada de la solución que estás aplicando actualmente."
                        android:textColor="#334155"
                        android:textSize="14sp"
                        android:lineSpacingExtra="3dp"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVerPreguntasTrampa"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_gravity="end"
                        android:text="Ver más ejemplos de preguntas →"
                        android:textColor="#2563EB"
                        android:textStyle="bold"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
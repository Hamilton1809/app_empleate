<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    tools:context=".BuscarEmpleoActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center_horizontal">

            <!-- Banner superior redondeado EMPLEATE -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="18dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#2563EB"
                app:strokeColor="#1E3A8A"
                app:strokeWidth="1dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="16dp">

                    <!-- Logo circular sin cuadrícula -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_centerVertical="true"
                        android:layout_alignParentStart="true"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="#FFFFFF">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Logo EMPLEATE"
                            android:scaleType="centerCrop"
                            android:scaleX="1.65"
                            android:scaleY="1.65"
                            android:src="@drawable/logo_empleate" />
                    </androidx.cardview.widget.CardView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:text="EMPLEATE"
                        android:textColor="#FFFFFF"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06" />

                    <ImageView
                        android:id="@+id/btnMenuBuscarEmpleo"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:src="@android:drawable/ic_menu_sort_by_size"
                        app:tint="#FFFFFF"
                        android:contentDescription="Menú" />
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#94A3B8"
                android:layout_marginBottom="18dp" />

            <!-- Título principal -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Conecta con oportunidades laborales y prepárate para el futuro"
                android:textColor="#1E3A8A"
                android:textSize="21sp"
                android:textStyle="bold"
                android:textAlignment="center"
                android:layout_marginBottom="14dp" />

            <!-- Descripción -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Encuentra empleos, practica para entrevistas y mejora tu perfil profesional con recursos gratuitos."
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAlignment="center"
                android:layout_marginBottom="18dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#94A3B8"
                android:layout_marginBottom="20dp" />

            <!-- Botones superiores: Buscar empleo / Registrarse gratis -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnIrPostularOfertas"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="Buscar empleo"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="#2563EB"
                    app:cornerRadius="24dp"
                    app:elevation="3dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRegistrarseGratis"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Registrarse gratis"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="#1E3A8A"
                    app:cornerRadius="24dp"
                    app:elevation="3dp" />
            </LinearLayout>

            <!-- Caja redondeada de búsqueda estilo transparente tipo iPhone -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="22dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#66FFFFFF"
                app:strokeColor="#802563EB"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="8dp">

                    <EditText
                        android:id="@+id/etQueEmpleo"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@android:color/transparent"
                        android:hint="¿Qué empleo buscas?"
                        android:textColor="#0F172A"
                        android:textColorHint="#64748B"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:inputType="text"
                        android:autofillHints="none" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#402563EB" />

                    <EditText
                        android:id="@+id/etUbicacion"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@android:color/transparent"
                        android:hint="Ubicación (ej: Popayán)"
                        android:textColor="#0F172A"
                        android:textColorHint="#64748B"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:inputType="text"
                        android:autofillHints="postalAddress" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Botón redondeado BUSCAR -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBuscar"
                android:layout_width="200dp"
                android:layout_height="52dp"
                android:text="BUSCAR"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="#2196F3"
                app:cornerRadius="26dp"
                app:elevation="4dp"
                app:icon="@android:drawable/ic_menu_search"
                app:iconGravity="textStart"
                app:iconTint="#FFFFFF" />

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:padding="32dp"
    tools:context=".AdminSplashActivity">

    <!-- Título Principal Administrativo -->
    <TextView
        android:id="@+id/tvTituloSplashAdmin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="EMPLEATE\nAPP\nADMINISTRATIVO"
        android:textAlignment="center"
        android:textColor="#1E3A8A"
        android:textSize="26sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        app:layout_constraintBottom_toTopOf="@+id/cardLogoAdmin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <!-- Logo Circular Administrativo -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardLogoAdmin"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="40dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="80dp"
        app:cardElevation="12dp"
        app:layout_constraintBottom_toTopOf="@+id/btnIngresarAdmin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTituloSplashAdmin">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Logo Empleate Administrativo"
            android:scaleType="centerCrop"
            android:scaleX="1.65"
            android:scaleY="1.65"
            android:src="@drawable/logo_empleate" />
    </androidx.cardview.widget.CardView>

    <!-- Botón Ingresar Ahora -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnIngresarAdmin"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginBottom="24dp"
        android:text="INGRESAR AHORA"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="#1E3A8A"
        app:cornerRadius="12dp"
        app:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>